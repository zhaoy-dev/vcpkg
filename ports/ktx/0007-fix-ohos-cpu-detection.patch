diff --git a/cmake/cputypetest.cmake b/cmake/cputypetest.cmake
--- a/cmake/cputypetest.cmake
+++ b/cmake/cputypetest.cmake
@@ -67,6 +67,16 @@
 function(set_target_processor_type out)
     if(ANDROID_ABI AND "${ANDROID_ABI}" STREQUAL "armeabi-v7a")
         set(${out} armv7 PARENT_SCOPE)
+    # OHOS uses OHOS_ARCH instead of ANDROID_ABI for architecture detection.
+    # Without this, cross-compiling from Windows misdetects the target as x86_64.
+    elseif(OHOS_ARCH AND "${OHOS_ARCH}" STREQUAL "armeabi-v7a")
+        set(${out} armv7 PARENT_SCOPE)
+    elseif(OHOS_ARCH AND "${OHOS_ARCH}" STREQUAL "arm64-v8a")
+        set(${out} arm64 PARENT_SCOPE)
+    elseif(OHOS_ARCH AND "${OHOS_ARCH}" STREQUAL "x86")
+        set(${out} x86 PARENT_SCOPE)
+    elseif(OHOS_ARCH AND "${OHOS_ARCH}" STREQUAL "x86_64")
+        set(${out} x86_64 PARENT_SCOPE)
     elseif(ANDROID_ABI AND "${ANDROID_ABI}" STREQUAL "arm64-v8a")
         set(${out} arm64 PARENT_SCOPE)
     elseif(ANDROID_ABI AND "${ANDROID_ABI}" STREQUAL "x86")
